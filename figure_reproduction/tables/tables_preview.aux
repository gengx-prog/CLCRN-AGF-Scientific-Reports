\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Five-replicate comparison of CLCRN-AGF and the schedule-matched CLCRN control. Values are mean$\pm $sample standard deviation across seeds 2021--2025. Differences are CLCRN-AGF minus control; negative values favour CLCRN-AGF. Confidence intervals and two-sided $p$-values use Welch's unequal-variance approximation.}}{1}{}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:primary}{{1}{1}{}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Contextual test results on the same test split. Persistence is deterministic; control and CLCRN-AGF are means across five seeds. All methods use the same zero-inclusive, spatially unweighted evaluation over the full 12-hour forecast. Lower is better.}}{1}{}\protected@file@percent }
\newlabel{tab:context}{{2}{1}{}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Component ablations with a matched 100-epoch FP32 training protocol. All entries report mean$\pm $sample standard deviation over seeds 2023--2025 on the full 12-hour test forecast. Lower is better.}}{2}{}\protected@file@percent }
\newlabel{tab:ablation}{{3}{2}{}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Gate-activation statistics pooled over all five CLCRN-AGF seeds and the full test set. The gate balances a graph-aggregated projection and a residual linear projection of the same input, before CLConv. Standard deviations describe the pooled population of scalar gates.}}{2}{}\protected@file@percent }
\newlabel{tab:gate}{{4}{2}{}{table.4}{}}
