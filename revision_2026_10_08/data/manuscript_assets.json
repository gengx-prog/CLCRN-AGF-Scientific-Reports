{
  "figures": {
    "fig3_context_current_split.pdf": {
      "original_figure": 3,
      "data": "table2_current_context.csv",
      "caption": "Current-split cumulative 12-hour MAE. Persistence is deterministic; control and AGF are five-seed means. All results use the same zero-inclusive, spatially unweighted evaluator. Panels have task-specific physical units. This is contextual, not a causal decomposition of schedule changes."
    },
    "fig4_primary_replicates.pdf": {
      "original_figure": 4,
      "data": "primary_per_seed.csv",
      "caption": "Cumulative 12-hour MAE (top) and RMSE (bottom) from the same 40 checkpoints used in Table 1. Coloured points are five independently trained replicates per variant; black diamonds/error bars denote mean plus or minus sample standard deviation. No pairing of seed labels is assumed."
    },
    "fig5_horizon_consistent.pdf": {
      "original_figure": 5,
      "data": "horizon_per_seed.csv",
      "caption": "Exact-lead MAE (solid) and cumulative MAE from lead 1 to each plotted hour (dashed), averaged over the same five seeds per variant as Table 1. Shading denotes plus or minus sample SD across seeds for exact-lead MAE. Cumulative endpoints at 12 hours equal the corresponding Table 1 MAEs; panels use task-specific units."
    },
    "fig6_primary_effects.pdf": {
      "original_figure": 6,
      "data": "table1_primary_statistics.csv",
      "caption": "AGF-minus-control mean differences and 95% Welch intervals from Table 1, divided by the corresponding observed control mean and expressed as percentages. Negative values favour AGF. These are rescaled difference intervals, not confidence intervals from a separate ratio estimator. No single selected AGF run or historical schedule result enters this figure."
    },
    "fig7_robustness_consistent.pdf": {
      "original_figure": 7,
      "data": "robustness_per_seed_mask.csv",
      "caption": "Exploratory missing-input stress test using 64 deterministically spaced test windows, the same five trained seeds per variant as Table 1, and three mask seeds (11, 22, 33) at each nonzero ratio. A node mask is fixed across 12 input hours and all signal channels; standardized inputs are set to zero (training-mean imputation). Changes are relative to the clean score on the same 64 windows for each checkpoint. Masks are averaged within a trained seed; points/error bars show mean plus or minus sample SD across five trained seeds. These are sampled diagnostics, not complete-test performance or statistical significance tests."
    },
    "fig8_gate_consistent.pdf": {
      "original_figure": 8,
      "data": "gate_histogram.csv",
      "caption": "Full-test distributions of scalar sigmoid gates for all four tasks and the same five AGF checkpoints as Table 1. Gates are collected over 657 test windows, 12 input hours, 2048 nodes and 8 output channels per seed. Thin grey curves are individual seeds and the coloured curve is the pooled 100-bin density. The gate mixes adaptive graph aggregation and a nodewise residual projection before CLConv. Gate magnitudes do not by themselves measure the relative contribution of the two branches."
    }
  },
